Map.addLayer(my_aoi,{},'aoi', true);

//Rename Bands for Sentinel 2
var renameBands_sent2 = function(image){
  var bands = ['B2','B3','B4','B8','B11','B12','QA60'];
  var newBands = ['B','G','R','NIR','SWIR1','SWIR2','QA60'];
  return image.select(bands).rename(newBands);
};

//Rename Bands for PlanetScope
var renameBands_planet = function(image){
  var bands = ['b1','b2','b3','b4','b5','b6','b7','b8'];
  var newBands = ['R','G','B','G1','Y','R1','RE','NIR'];
  return image.select(bands).rename(newBands);
};

//CloudMask for Sentinel 2
var cloudMask_sent2 = function(image){
  var qa = image.select('QA60');
  var cloudShadowBitValue = 1 << 10;
  var cloudBitValue = 1 << 11;
  var shadowmask = qa.bitwiseAnd(cloudShadowBitValue).eq(0);
  var cloudmask = qa.bitwiseAnd(cloudBitValue).eq(0);
  var finalmask = shadowmask.and(cloudmask);
  return image.updateMask(finalmask);
};

// Load Sentinel 2 images
var sent2 = ee.ImageCollection("COPERNICUS/S2")
                .filterBounds(aoi_1)
                .filterDate('2022-10-01','2023-03-31')
                .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',0.5))
                .map(cloudMask_sent2)
                .map(renameBands_sent2)
                .map(function(image){return image.clip(my_aoi)});

print("Sentinel 2 image collection", sent2);
Map.addLayer(sent2, {bands: ['R', 'G', 'B'], min:1000, max:3500}, 'Sentinel 2 Image Collection');


// Load Planet Image collection
var planet = ee.ImageCollection([image,image2,image3,image4,image5,image6,image7])
                .map(renameBands_planet)
                .map(function(image){return image.clip(my_aoi)});
print('Planet Img Col', planet);
Map.addLayer(planet, {bands: ['R','G','B'], min:185, max:1404}, 'Planet Image Collection');

// Load Sentinel 1 Image collection
var sent1_VH_mean = ee.Image('projects/ee-tanzania/assets/S1_MeanVH_ASCENDING')
                .clip(my_aoi);
print('Sentinel 1 VH', sent1_VH_mean);
Map.addLayer(sent1_VH_mean, {min:-30, max: 0}, 'Sentinel 1 VH_mean');


var sent1_VV_mean = ee.Image('projects/ee-tanzania/assets/S1_MeanVV_ASCENDING')
                .clip(my_aoi);
print('Sentinel 1 VV', sent1_VV_mean);
Map.addLayer(sent1_VV_mean, {min: -25, max: 5}, 'Sentinel 1 VV_mean');


// Get information about Planet Projection
var planetProjection = planet.first().projection();
print('planetProjection', planetProjection);

// Resample Sentinel Images to PlanetScope Resolution
var sent2_resampled = sent2.map(function(image) {
  return image.reduceResolution({reducer: ee.Reducer.mean()})
              .reproject({crs: planetProjection});
});

print('Sentinel 2 resmpled', sent2_resampled);

var sent1_resampled_VH = sent1_VH_mean.reduceResolution({reducer: ee.Reducer.mean()})
              .reproject({crs: planetProjection});


print('Sentinel 1 VH resmpled', sent1_resampled_VH);

var sent1_resampled_VV = sent1_VH_mean.reduceResolution({reducer: ee.Reducer.mean()})
              .reproject({crs: planetProjection});

print('Sentinel 1 VV resmpled', sent1_resampled_VV);


// NDVI and NDWI functions for Sentinel
var sent_ndvi = function(image){
  var ndvi = image.normalizedDifference(['NIR','R']);
  return image.addBands(ndvi.rename('sent_NDVI')).float();
};

var sent_ndwi = function(image){
  var ndwi = image.normalizedDifference(['G','NIR']);
  return image.addBands(ndwi.rename('sent_NDWI')).float();
};

var rvi = sent1_VH_mean.multiply(4).divide(sent1_VV_mean.add(sent1_VH_mean));
print('Radar Vegetation Index', rvi);

// NDVI and NDWI functions for planet
var planet_ndvi = function(image){
  var ndvi = image.normalizedDifference(['NIR','R']);
  return image.addBands(ndvi.rename('planet_NDVI')).float();
};

var planet_ndwi = function(image){
  var ndwi = image.normalizedDifference(['G','NIR']);
  return image.addBands(ndwi.rename('planet_NDWI')).float();
};

// Add indices to image collections
var sent2_resampled_indices = sent2_resampled.map(sent_ndvi).map(sent_ndwi);
print('sent2_resampled_indices', sent2_resampled_indices);

var planet_indices = planet.map(planet_ndvi).map(planet_ndwi);
print('planet_indices', planet_indices);

// Get the Maximum NDVI composite image
var sent2_resampled_indices_composite = sent2_resampled_indices.qualityMosaic('sent_NDVI');
print('Max NDVI Sentinel Composite', sent2_resampled_indices_composite);

var planet_indices_composite = planet_indices.qualityMosaic('planet_NDVI');
print('Max NDVI Planet Composite', planet_indices_composite);

var sent1_indices_composite = rvi.reduce(ee.Reducer.max());
print('Max RVI Composite', sent1_indices_composite);

// Merge both Planet and Sentinel Images

var merged_image = sent2_resampled_indices_composite.select('sent_NDVI').addBands(planet_indices_composite
                                                    .select('planet_NDVI')).addBands(sent1_indices_composite);
print('Merged Sentinel and Planet Image', merged_image);
// The total accuracy is 0.7 without the planet_composite while 0.6 with it, same goes for the keppa
// adding the sentinel bands would also increase the accurcy of the classification

// Resample merged Images to PlanetScope Resolution
var merged_image_resampled = merged_image.reproject({crs: planetProjection});

print('merged_image_resampled', merged_image_resampled);

