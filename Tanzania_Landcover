// Accuracy assessment 
var classified_validated = validation_samples.classify(trained_classifier);
var error_matrix = classified_validated.errorMatrix({
  actual: 'Class ID',
  predicted: 'classification'
});
print('Validation error matrix', error_matrix);

var total_accuracy = error_matrix.accuracy();
