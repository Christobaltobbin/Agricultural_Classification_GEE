var bands = ['sent_NDVI','planet_NDVI','max'];


var sampled_training_data = merged_image_resampled.select(bands).sampleRegions({
  // Define the training FeatureCollection
  collection: training_data,
  // Define the attribute column to look at.
  properties: ['Class ID'],
  // Set the scale to get pixels in the polygons.
  scale: 3
});

// print('sampled_training_data',sampled_training_data.first());

// Splitting training samples for training data and validation data
var random_column = sampled_training_data.randomColumn(); //splits the data
var training_samples = random_column.filter(ee.Filter.gte('random', 0.7)); //70% trainig data
var validation_samples = random_column.filter(ee.Filter.lte('random', 0.3)); //30%validation data

// define classifier to use
var classifier = ee.Classifier.smileRandomForest(70);
// a tree number of 100 and above give an error

// train classifier with training data
var trained_classifier = classifier.train({
  features: training_samples,
  classProperty: 'Class ID',
  inputProperties: bands
});

var trainAccuracy = ee.FeatureCollection(trained_classifier.confusionMatrix());
print('Confusion Matrix',trainAccuracy);

// classify merged Sentinel and Planet image
var classified_merged = merged_image_resampled.select(bands).classify(trained_classifier);
print('Classified Image', classified_merged);
var classified_merged_clipped = classified_merged.clip(aoi_2);

// define color palette 
